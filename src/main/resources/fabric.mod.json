{
  "schemaVersion": 1,
  "id": "shulkerpalette",
  "version": "${version}",
  "name": "Shulker Palette",
  "description": "Hold a shulker box and build straight out of it: random blocks, a picked block, or a gradient row by row.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/shulker-palette",
    "sources": "https://github.com/trevorschoeny/shulker-palette"
  },
  "license": "MIT",
  "icon": "assets/shulkerpalette/icon.png",
  "environment": "*",
  "mixins": [
    "shulkerpalette.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.shulkerpalette.ShulkerPalette"
    ],
    "client": [
      "com.trevorschoeny.shulkerpalette.ShulkerPaletteClient"
    ],
    "modmenu": [
      "com.trevorschoeny.shulkerpalette.config.ModMenuEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.2.0 <8.0.0",
    "slotkit": ">=1.1.0 <2.0.0"
  },
  "suggests": {
    "modmenu": "*",
    "keybindery": ">=1.3.0"
  },
  "custom": {
    "slotkit": {
      "bothSides": "required"
    }
  }
}
