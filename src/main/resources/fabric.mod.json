{
  "schemaVersion": 1,
  "id": "shulkerpalette",
  "version": "${version}",
  "name": "Shulker Palette",
  "description": "Turns a shulker box into a block palette that places blocks from inside at random, by pick, or as a gradient.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/shulker-palette",
    "sources": "https://github.com/trevorschoeny/shulker-palette",
    "issues": "https://github.com/trevorschoeny/shulker-palette/issues"
  },
  "license": "MIT",
  "icon": "assets/shulkerpalette/icon.png",
  "environment": "*",
  "mixins": [
    "shulkerpalette.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.shulkerpalette.ShulkerPalette"
    ],
    "client": [
      "com.trevorschoeny.shulkerpalette.ShulkerPaletteClient"
    ],
    "modmenu": [
      "com.trevorschoeny.shulkerpalette.config.ModMenuEntry"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.4.0 <8.0.0",
    "slotkit": ">=2.1.0 <3.0.0"
  },
  "suggests": {
    "modmenu": "*",
    "keybindery": ">=1.3.0"
  },
  "custom": {
    "slotkit": {
      "bothSides": "required"
    }
  }
}
